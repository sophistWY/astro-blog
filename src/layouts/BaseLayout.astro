---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = '汪洋 · 个人技术博客', description = '记录 iOS、Flutter、AI 与持续思考。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon-v2.svg" type="image/svg+xml" />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="shell nav-wrap">
				<a class="brand" href="/" aria-label="返回首页">
					<span class="brand-mark">WY</span>
					<span>汪洋的博客</span>
				</a>
				<nav class="nav-links" aria-label="主导航">
					<a href="/">首页</a>
					<a href="/archive/">归档</a>
					<a href="/about/">关于</a>
					<a href="https://github.com/sophistWY" target="_blank" rel="noreferrer">GitHub ↗</a>
					<button class="theme-toggle" type="button" aria-label="切换深色模式" data-theme-toggle>◐</button>
				</nav>
			</div>
		</header>
		<main><slot /></main>
		<footer class="site-footer">
			<div class="shell footer-wrap">
				<span>© {new Date().getFullYear()} sophistWY</span>
				<span>Keep hungry, keep foolish.</span>
			</div>
		</footer>
		<script is:inline>
			const key = 'wy-theme';
			const root = document.documentElement;
			const saved = localStorage.getItem(key);
			if (saved) root.dataset.theme = saved;
			document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
				const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				localStorage.setItem(key, next);
			});
		</script>
	</body>
</html>
