---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.filter((post) => post.data.highlight).slice(0, 3);
const latest = posts.slice(0, 6);
const categories = [...new Set(posts.map((post) => post.data.category))];
const formatDate = (date: Date) => {
	const options = { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Shanghai' } as const;
	const dateText = date.toLocaleDateString('zh-CN', options);
	return date.getHours() || date.getMinutes() || date.getSeconds()
		? `${dateText} ${date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' })}`
		: dateText;
};
---
<BaseLayout>
	<section class="home-hero shell">
		<div class="home-hero-top"><p class="eyebrow">Notes from a curious developer</p><span class="home-year">EST. 2016 — {new Date().getFullYear()}</span></div>
		<div class="home-hero-grid">
			<div class="home-title"><h1>把复杂的技术，<br /><span>写成清晰的答案。</span></h1><p>我是汪洋，一名 iOS / Flutter 开发者，也在持续探索 AI、工具和产品思维。这里记录实践、复盘与还没想明白的问题。</p><div class="hero-actions"><a class="button button-primary" href="/archive/">浏览文章 <span>↗</span></a><a class="button button-ghost" href="/about/">关于我</a></div></div>
			<div class="home-manifesto"><div class="manifesto-stamp">WY<br /><small>journal</small></div><p>“保持好奇，<br />保持清醒，<br />保持输出。”</p><div class="manifesto-rule"></div><span>iOS · Flutter · AI</span></div>
		</div>
	</section>

	<section class="shell home-stats" aria-label="博客统计"><div><strong>{posts.length.toString().padStart(2, '0')}</strong><span>篇文章</span></div><div><strong>{categories.length.toString().padStart(2, '0')}</strong><span>个主题</span></div><div><strong>10</strong><span>年记录</span></div><a href="/about/">了解这个博客 <span>↗</span></a></section>

	{featured.length > 0 && <section class="shell home-featured"><div class="home-section-head"><div><p class="eyebrow">Editor&apos;s picks</p><h2>值得先读</h2></div><a href="/archive/">全部文章 <span>↗</span></a></div><div class="home-featured-grid"><a class="home-featured-main" href={`/posts/${featured[0].id}/`}><div class="feature-kicker"><span>01</span><span>{featured[0].data.category}</span></div><h3>{featured[0].data.title}</h3><p>{featured[0].data.description}</p><span class="feature-link">开始阅读 <b>↗</b></span></a><div class="home-featured-side">{featured.slice(1).map((post, index) => <a href={`/posts/${post.id}/`} class="home-small-feature"><span class="small-number">0{index + 2}</span><div><span class="small-category">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="small-arrow">↗</span></a>)}</div></div></section>}

	<section class="shell home-latest"><div class="home-section-head"><div><p class="eyebrow">Fresh from the notebook</p><h2>最近更新</h2></div><a href="/archive/">按时间浏览 <span>↗</span></a></div><div class="home-latest-list">{latest.map((post, index) => <a href={`/posts/${post.id}/`} class="home-latest-row"><span class="latest-index">{String(index + 1).padStart(2, '0')}</span><time>{formatDate(post.data.pubDate)}</time><div><span class="latest-category">{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="latest-arrow">↗</span></a>)}</div></section>
</BaseLayout>
